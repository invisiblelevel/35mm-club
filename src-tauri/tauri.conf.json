{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "35mm Club",
  "version": "1.0.0",
  "identifier": "com.invisiblelevel.35mmclub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "35mm Club",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://image.tmdb.org https://s4.anilist.co https://shikimori.io https://lain.bgm.tv https://api.iconify.design data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https://api.themoviedb.org https://graphql.anilist.co https://shikimori.io https://api.bgm.tv https://api.iconify.design"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Russian", "SimpChinese"],
        "displayLanguageSelector": true,
		"installMode": "perMachine"
      }
    }
  }
}